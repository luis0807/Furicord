# Copie para server/.env (que NÃO vai para o Git) e preencha.
# No Render, cadastre estas mesmas variáveis em Environment.

# URI do MongoDB Atlas, com o nome do banco no final (/furicord)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/furicord

# URL do front no Vercel, sem barra no final (várias: separe por vírgula)
CORS_ORIGIN=https://furicord.vercel.app

# Opcional: STUN/TURN em JSON para voz/tela em redes difíceis (4G, CGNAT)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# O Render define PORT sozinho; localmente o padrão é 4000
# PORT=4000
