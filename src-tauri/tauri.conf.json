{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Furicord",
  "version": "0.1.0",
  "identifier": "com.furicord.desktop",
  "build": {
    "frontendDist": "https://furicord.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Furicord",
        "url": "https://furicord.vercel.app",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AudioServiceOutOfProcess --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QjMzQzlDMTg0RDVDQkYKUldTL1hFMFluRHl6T0pyQWdGWFA3YVVKRXowc1BrSDFUMnpwNW9TNm0zSml4K0hYNlRuOXhEY1kK",
      "endpoints": ["https://github.com/luis0807/Furicord/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
