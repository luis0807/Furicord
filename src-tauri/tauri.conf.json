{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Furicord",
  "version": "0.1.0",
  "identifier": "com.furicord.desktop",
  "build": {
    "frontendDist": "https://furicord.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Furicord",
        "url": "https://furicord.vercel.app",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
