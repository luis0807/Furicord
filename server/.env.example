# Copie para server/.env (que NÃO vai para o Git) e preencha.
# No Render, cadastre estas mesmas variáveis em Environment.

# URI do MongoDB Atlas, com o nome do banco no final (/furicord)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/furicord

# URL do front no Vercel, sem barra no final (várias: separe por vírgula)
CORS_ORIGIN=https://furicord.vercel.app

# Voz/tela para quem está em 4G, CGNAT ou rede corporativa: precisa de um TURN.
# Recomendado: TURN da Cloudflare (painel -> Realtime -> TURN Server -> criar chave).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Teto mensal do TURN da Cloudflare, em GB (a franquia gratis e de 1000). Ao chegar
# nele o TURN e desligado ate virar o mes. Padrao: 900.
# TURN_MONTHLY_LIMIT_GB=900
# Alertas de consumo (log do servidor + faixa de aviso no app), em GB.
# TURN_ALERT_GB=500,700
#
# Opcional: conferir o uso oficial na Cloudflare (token com "Account Analytics: Read").
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ANALYTICS_TOKEN=
#
# Ou qualquer outro provedor, fixo, em JSON:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# O Render define PORT sozinho; localmente o padrão é 4000
# PORT=4000
#
# Contas que veem o painel "Servidor de voz" nas Configuracoes (consumo do TURN por
# dia, por pessoa e por tipo de conexao), separadas por virgula.
# ADMIN_NAMES=SeuNome
